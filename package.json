{
  "name": "survival-spanish",
  "version": "0.1.0",
  "private": true,
  "description": "Data-driven Spanish language learning app for immigrants in Spain",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.0.0",
  "workspaces": [
    "apps/client",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev:backend": "yarn workspace @ss/backend dev",
    "dev:client": "yarn workspace @ss/client start",
    "build": "yarn workspaces foreach -t run build",
    "clean": "find . -type d -name dist -o -name build -o -name .next | xargs rm -rf"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-native": "^4.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  }
}
